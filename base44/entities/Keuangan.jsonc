{
  "name": "Keuangan",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal transaksi"
    },
    "jenis": {
      "type": "string",
      "enum": [
        "Pemasukan",
        "Pengeluaran"
      ],
      "description": "Jenis transaksi"
    },
    "tipe_transaksi": {
      "type": "string",
      "enum": [
        "SPP/Bulanan",
        "Ujian Sekolah",
        "Daftar Ulang",
        "Kelulusan",
        "Belanja Harian",
        "Belanja Bulanan",
        "Belanja Tahunan",
        "Kasbon Pegawai",
        "Gaji/Honorarium",
        "Kegiatan",
        "BOSP",
        "Transaksi Khusus",
        "Donatur",
        "Lainnya"
      ],
      "description": "Tipe detail transaksi"
    },
    "kategori": {
      "type": "string",
      "enum": [
        "SPP",
        "BOS",
        "BOSP",
        "Donatur",
        "Gaji",
        "Operasional",
        "Sarpras",
        "Listrik",
        "Air",
        "Internet",
        "Kegiatan",
        "ATK",
        "Kasbon",
        "Ujian",
        "Daftar Ulang",
        "Kelulusan",
        "Lainnya"
      ],
      "description": "Kategori transaksi"
    },
    "uraian": {
      "type": "string",
      "description": "Deskripsi transaksi"
    },
    "jumlah": {
      "type": "number",
      "description": "Nominal transaksi"
    },
    "terbilang": {
      "type": "string",
      "description": "Terbilang nominal dalam huruf"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa (untuk transaksi siswa)"
    },
    "nis": {
      "type": "string",
      "description": "NIS siswa"
    },
    "nama_siswa": {
      "type": "string",
      "description": "Nama siswa"
    },
    "kelas": {
      "type": "string",
      "description": "Kelas siswa"
    },
    "tarif_iuran_id": {
      "type": "string",
      "description": "ID TarifIuran yang dipilih saat input transaksi siswa (penanda eksplisit item iuran \u2014 dipakai pencocokan transaksi, peringatan transaksi ganda, dan fitur SPP Juli gratis PPDB)"
    },
    "guru_id": {
      "type": "string",
      "description": "ID pegawai (untuk transaksi pegawai)"
    },
    "nip_pegawai": {
      "type": "string",
      "description": "NIP pegawai"
    },
    "nama_pegawai": {
      "type": "string",
      "description": "Nama pegawai"
    },
    "jabatan_pegawai": {
      "type": "string",
      "description": "Jabatan penerima transaksi"
    },
    "nama_donatur": {
      "type": "string",
      "description": "Nama donatur (untuk transaksi donasi)"
    },
    "bulan_dibayar": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bulan SPP yang dibayar dalam transaksi ini"
    },
    "bulan": {
      "type": "string",
      "description": "Bulan (untuk transaksi pegawai, Januari-Desember)"
    },
    "sumber_rekening": {
      "type": "string",
      "description": "Sumber atau rekening terkait"
    },
    "pic": {
      "type": "string",
      "description": "Pencatat transaksi (bendahara)"
    },
    "penerima": {
      "type": "string",
      "description": "Nama penerima transaksi"
    },
    "penerima_jabatan": {
      "type": "string",
      "description": "Jabatan penerima transaksi"
    },
    "rincian_gaji": {
      "type": "object",
      "description": "Rincian komponen gaji (untuk transaksi honorarium)",
      "properties": {
        "gaji_pokok": {
          "type": "number",
          "default": 0
        },
        "jabatan": {
          "type": "number",
          "default": 0
        },
        "bpjs": {
          "type": "number",
          "default": 0
        },
        "t_transport": {
          "type": "number",
          "default": 0
        },
        "pembina": {
          "type": "number",
          "default": 0
        },
        "lembur": {
          "type": "number",
          "default": 0
        },
        "wali_kelas": {
          "type": "number",
          "default": 0
        },
        "pulsa": {
          "type": "number",
          "default": 0
        },
        "t_tidak_tetap": {
          "type": "number",
          "default": 0
        },
        "pensiun": {
          "type": "number",
          "default": 0
        }
      }
    },
    "bukti_file": {
      "type": "string",
      "description": "URL file bukti transaksi"
    },
    "rencana_belanja_id": {
      "type": "string",
      "description": "ID rencana belanja terkait"
    },
    "status_bayar": {
      "type": "string",
      "enum": [
        "Lunas",
        "Belum Lunas",
        "Cicilan"
      ],
      "default": "Lunas",
      "description": "Status pembayaran"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran transaksi"
    },
    "is_iuran_muka": {
      "type": "boolean",
      "default": false,
      "description": "True = setoran Iuran Muka (pembayaran iuran tahun mendatang). TIDAK dihitung sebagai pembayaran iuran mana pun \u2014 uang sudah masuk kas dan tersimpan sebagai saldo IuranMuka per siswa per TA tujuan."
    },
    "aplikasi_iuran_muka": {
      "type": "boolean",
      "default": false,
      "description": "True = transaksi hasil penerapan Saldo Iuran Muka. Mengurangi tagihan iuran tahun ajaran tujuan, tetapi NETRAL terhadap kas (saldo kas sudah masuk saat setoran Iuran Muka)."
    },
    "is_saldo_awal": {
      "type": "boolean",
      "default": false,
      "description": "True = pengakuan pembayaran iuran yang uangnya sudah masuk lewat Saldo Awal (kas sebelum sistem dipakai). Dihitung sebagai pembayaran siswa (ceklis SPP & tunggakan lunas), tetapi NETRAL terhadap kas \u2014 tidak mengubah saldo kas, laporan Pemasukan & Pengeluaran, maupun Saldo Sumber Dana."
    }
  },
  "required": [
    "tanggal",
    "jenis",
    "kategori",
    "jumlah"
  ]
}