{
  "name": "Siswa",
  "type": "object",
  "properties": {
    "nis": {
      "type": "string",
      "description": "Nomor Induk Siswa"
    },
    "nisn": {
      "type": "string",
      "description": "Nomor Induk Siswa Nasional"
    },
    "nama": {
      "type": "string",
      "description": "Nama lengkap siswa"
    },
    "jenis_kelamin": {
      "type": "string",
      "enum": [
        "Laki-laki",
        "Perempuan"
      ]
    },
    "kelas_id": {
      "type": "string",
      "description": "ID kelas siswa"
    },
    "nama_kelas": {
      "type": "string",
      "description": "Nama kelas untuk tampilan"
    },
    "tanggal_lahir": {
      "type": "string",
      "format": "date"
    },
    "alamat": {
      "type": "string"
    },
    "nama_ortu": {
      "type": "string",
      "description": "Nama orang tua/wali (legacy)"
    },
    "no_telp_ortu": {
      "type": "string",
      "description": "No telp orang tua (legacy)"
    },
    "nama_ayah_kandung": {
      "type": "string",
      "description": "Nama ayah kandung"
    },
    "nama_ibu_kandung": {
      "type": "string",
      "description": "Nama ibu kandung"
    },
    "nama_wali": {
      "type": "string",
      "description": "Nama wali (opsional)"
    },
    "kontak_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no_telp": {
            "type": "string"
          },
          "hubungan": {
            "type": "string",
            "enum": [
              "Ibu",
              "Ayah",
              "Wali"
            ]
          }
        }
      },
      "description": "Daftar kontak HP/WA orang tua/wali"
    },
    "pekerjaan_ayah": {
      "type": "string"
    },
    "pekerjaan_ibu": {
      "type": "string"
    },
    "pekerjaan_wali": {
      "type": "string"
    },
    "penghasilan_ayah": {
      "type": "number"
    },
    "penghasilan_ibu": {
      "type": "number"
    },
    "penghasilan_wali": {
      "type": "number"
    },
    "koordinat": {
      "type": "string",
      "description": "Koordinat rumah (lat,lng)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Lulus",
        "Pindah",
        "Keluar"
      ],
      "default": "Aktif"
    },
    "tahun_lulus": {
      "type": "string",
      "description": "Tahun ajaran saat lulus (contoh: 2024/2025)"
    }
  },
  "required": [
    "nis",
    "nama",
    "kelas_id",
    "nama_kelas"
  ]
}