{
  "name": "Siswa",
  "type": "object",
  "properties": {
    "nis": {
      "type": "string",
      "description": "Nomor Induk Siswa (Kunci Utama)"
    },
    "nisn": {
      "type": "string",
      "description": "Nomor Induk Siswa Nasional"
    },
    "registrasi": {
      "type": "string",
      "enum": [
        "Siswa Baru",
        "Naik Kelas",
        "Mengulang"
      ],
      "description": "Status registrasi siswa. Auto dari tingkat kelas: Tingkat 7 = Siswa Baru, Tingkat 8 & 9 = Naik Kelas."
    },
    "nama": {
      "type": "string",
      "description": "Nama lengkap siswa"
    },
    "jenis_kelamin": {
      "type": "string",
      "enum": [
        "Laki-laki",
        "Perempuan"
      ]
    },
    "kelas_id": {
      "type": "string",
      "description": "ID kelas siswa"
    },
    "nama_kelas": {
      "type": "string",
      "description": "Nama kelas untuk tampilan"
    },
    "tempat_lahir": {
      "type": "string",
      "description": "Tempat lahir siswa"
    },
    "tanggal_lahir": {
      "type": "string",
      "format": "date"
    },
    "nik": {
      "type": "string",
      "description": "NIK siswa"
    },
    "agama": {
      "type": "string",
      "enum": [
        "Islam",
        "Kristen",
        "Katolik",
        "Hindu",
        "Buddha",
        "Konghucu",
        "Kepercayaan"
      ],
      "default": "Islam"
    },
    "alamat": {
      "type": "string",
      "description": "Alamat lengkap (jalan)"
    },
    "rt": {
      "type": "string",
      "description": "RT"
    },
    "rw": {
      "type": "string",
      "description": "RW"
    },
    "kelurahan": {
      "type": "string",
      "description": "Kelurahan/Desa"
    },
    "kecamatan": {
      "type": "string",
      "description": "Kecamatan"
    },
    "nama_ortu": {
      "type": "string",
      "description": "Nama orang tua/wali (legacy)"
    },
    "no_telp_ortu": {
      "type": "string",
      "description": "No telp orang tua (legacy)"
    },
    "nama_ayah_kandung": {
      "type": "string",
      "description": "Nama ayah kandung"
    },
    "nama_ibu_kandung": {
      "type": "string",
      "description": "Nama ibu kandung"
    },
    "nama_wali": {
      "type": "string",
      "description": "Nama wali (opsional)"
    },
    "kontak_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no_telp": {
            "type": "string"
          },
          "hubungan": {
            "type": "string",
            "enum": [
              "Ibu",
              "Ayah",
              "Wali"
            ]
          }
        }
      },
      "description": "Daftar kontak HP/WA orang tua/wali"
    },
    "tahun_lahir_ayah": {
      "type": "string",
      "description": "Tahun lahir ayah"
    },
    "pendidikan_ayah": {
      "type": "string",
      "description": "Pendidikan ayah (Dapodik)"
    },
    "pekerjaan_ayah": {
      "type": "string"
    },
    "penghasilan_ayah": {
      "type": "string",
      "description": "Penghasilan ayah (Dapodik range text)"
    },
    "nik_ayah": {
      "type": "string",
      "description": "NIK ayah"
    },
    "tahun_lahir_ibu": {
      "type": "string",
      "description": "Tahun lahir ibu"
    },
    "pendidikan_ibu": {
      "type": "string",
      "description": "Pendidikan ibu (Dapodik)"
    },
    "pekerjaan_ibu": {
      "type": "string"
    },
    "penghasilan_ibu": {
      "type": "string",
      "description": "Penghasilan ibu (Dapodik range text)"
    },
    "nik_ibu": {
      "type": "string",
      "description": "NIK ibu"
    },
    "tahun_lahir_wali": {
      "type": "string",
      "description": "Tahun lahir wali"
    },
    "pendidikan_wali": {
      "type": "string",
      "description": "Pendidikan wali (Dapodik)"
    },
    "pekerjaan_wali": {
      "type": "string"
    },
    "penghasilan_wali": {
      "type": "string",
      "description": "Penghasilan wali (Dapodik range text)"
    },
    "nik_wali": {
      "type": "string",
      "description": "NIK wali"
    },
    "penerima_kip": {
      "type": "string",
      "enum": [
        "Ya",
        "Tidak"
      ],
      "default": "Tidak"
    },
    "koordinat": {
      "type": "string",
      "description": "Koordinat rumah (lat,lng)"
    },
    "foto_7": {
      "type": "string",
      "description": "URL foto siswa jenjang 7 (rasio 3:4, terkompresi otomatis)"
    },
    "foto_8": {
      "type": "string",
      "description": "URL foto siswa jenjang 8 (rasio 3:4, terkompresi otomatis)"
    },
    "foto_9": {
      "type": "string",
      "description": "URL foto siswa jenjang 9 (rasio 3:4, terkompresi otomatis)"
    },
    "foto_ayah": {
      "type": "string",
      "description": "URL foto ayah kandung (opsional, terkompresi otomatis)"
    },
    "foto_ibu": {
      "type": "string",
      "description": "URL foto ibu kandung (opsional, terkompresi otomatis)"
    },
    "foto_wali": {
      "type": "string",
      "description": "URL foto wali (opsional, terkompresi otomatis)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Lulus",
        "Pindah",
        "Keluar"
      ],
      "default": "Aktif"
    },
    "tahun_lulus": {
      "type": "string",
      "description": "Tahun ajaran saat lulus (contoh: 2024/2025)"
    },
    "notif_absen3hari_minggu": {
      "type": "string",
      "description": "Key minggu (ISO week, cth: 2026-32) saat WA peringatan absen 3 hari terakhir dikirim. Digunakan untuk dedup \u2014 hanya kirim sekali per minggu."
    },
    "rapor_kuning_tanggal": {
      "type": "string",
      "description": "Timestamp (ISO) saat Status Rapor Kuning ditetapkan (poin bersih mencapai 300). Berlaku 40 hari kalender; setelah itu status hilang. Null jika tidak aktif."
    },
    "rapor_merah_tanggal": {
      "type": "string",
      "description": "Timestamp (ISO) saat Status Rapor Merah ditetapkan (poin bersih mencapai 600). Berlaku 120 hari kalender; setelah itu status hilang. Null jika tidak aktif."
    },
    "rapor_hitam_tanggal": {
      "type": "string",
      "description": "Timestamp (ISO) saat Status Rapor Hitam ditetapkan (poin bersih mencapai 1000). Permanen sampai dianulir."
    },
    "rapor_hitam_aktif": {
      "type": "boolean",
      "default": false,
      "description": "True jika Status Rapor Hitam sedang aktif. Tidak berubah otomatis kecuali dianulir ADMIN atas perintah Kepala Sekolah."
    },
    "rapor_hitam_anulir_at": {
      "type": "string",
      "description": "Timestamp (ISO) saat Status Hitam dianulir. Jika sudah pernah dianulir, status tidak aktif otomatis lagi meski poin tinggi."
    }
  },
  "required": [
    "nis",
    "nama",
    "kelas_id",
    "nama_kelas"
  ]
}