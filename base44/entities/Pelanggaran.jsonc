{
  "name": "Pelanggaran",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pelanggaran"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "kelas_id": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "jenis_pelanggaran": {
      "type": "string",
      "enum": [
        "Sangat Ringan",
        "Ringan",
        "Sedang",
        "Berat",
        "Sangat Berat",
        "Khusus"
      ],
      "description": "Tingkat pelanggaran"
    },
    "kategori": {
      "type": "string",
      "enum": [
        "Keterlambatan",
        "Pakaian/Atribut",
        "Sikap/Perilaku",
        "Akademik",
        "Absensi",
        "Lainnya"
      ],
      "description": "Kategori pelanggaran"
    },
    "kode_pelanggaran": {
      "type": "string",
      "description": "Kode pelanggaran dari database"
    },
    "uraian": {
      "type": "string",
      "description": "Uraian pelanggaran"
    },
    "poin": {
      "type": "number",
      "description": "Poin pelanggaran"
    },
    "sanksi": {
      "type": "string",
      "description": "Sanksi yang diberikan"
    },
    "durasi_sanksi": {
      "type": "number",
      "description": "Durasi sanksi dalam hari"
    },
    "satuan_durasi": {
      "type": "string",
      "enum": [
        "Hari",
        "Bulan"
      ],
      "default": "Hari",
      "description": "Satuan durasi sanksi"
    },
    "progress_sanksi": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hari_ke": {
            "type": "number"
          },
          "tanggal": {
            "type": "string"
          },
          "selesai": {
            "type": "boolean"
          }
        }
      },
      "description": "Progress monitoring sanksi harian"
    },
    "pelapor_id": {
      "type": "string",
      "description": "ID Guru pelapor"
    },
    "pelapor": {
      "type": "string",
      "description": "Nama guru pelapor"
    },
    "status": {
      "type": "string",
      "enum": [
        "Proses",
        "Selesai"
      ],
      "default": "Proses",
      "description": "Status penanganan"
    }
  },
  "required": [
    "tanggal",
    "siswa_id",
    "nama_siswa",
    "jenis_pelanggaran",
    "uraian",
    "poin"
  ]
}