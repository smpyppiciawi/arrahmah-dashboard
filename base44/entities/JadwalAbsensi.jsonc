{
  "name": "JadwalAbsensi",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Nama / penanda jadwal (cth: Jam Masuk Pagi, Jam Pulang Jumat)"
    },
    "jenis": {
      "type": "string",
      "enum": [
        "Masuk",
        "Pulang",
        "Istirahat Mulai",
        "Istirahat Selesai",
        "Lainnya"
      ],
      "default": "Masuk",
      "description": "Jenis penanda jadwal absensi"
    },
    "jam": {
      "type": "string",
      "description": "Jam jadwal (format HH:mm)"
    },
    "hari": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Senin",
          "Selasa",
          "Rabu",
          "Kamis",
          "Jumat",
          "Sabtu"
        ]
      },
      "description": "Hari berlaku jadwal"
    },
    "toleransi_aktif": {
      "type": "boolean",
      "default": true,
      "description": "Aktif/nonaktifkan toleransi terlambat. Jika false, jam berapapun selama belum jam pulang dinyatakan Masuk."
    },
    "toleransi_menit": {
      "type": "number",
      "default": 0,
      "description": "Toleransi terlambat (menit) \u2014 khusus jenis Masuk, hanya berlaku jika toleransi_aktif true"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "Semua",
        "Siswa",
        "Pegawai"
      ],
      "default": "Semua",
      "description": "Berlaku untuk Siswa, Pegawai, atau Semua"
    },
    "keterangan": {
      "type": "string"
    },
    "aktif": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "label",
    "jenis",
    "jam",
    "hari"
  ]
}