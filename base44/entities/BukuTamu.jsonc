{
  "name": "BukuTamu",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal kunjungan tamu"
    },
    "jenis_tamu": {
      "type": "string",
      "enum": [
        "Tamu Dinas",
        "Tamu Orang Tua/Wali",
        "Tamu Yayasan",
        "Tamu Sekolah Lain",
        "Tamu Umum"
      ],
      "description": "Jenis tamu yang berkunjung"
    },
    "nama_lengkap": {
      "type": "string",
      "description": "Nama lengkap tamu (Dinas/Sekolah Lain/Yayasan/Umum)"
    },
    "instansi": {
      "type": "string",
      "description": "Instansi asal (Tamu Dinas)"
    },
    "jabatan": {
      "type": "string",
      "description": "Jabatan tamu (Dinas/Sekolah Lain/Yayasan)"
    },
    "no_hp_wa": {
      "type": "string",
      "description": "No HP/WA tamu"
    },
    "keperluan": {
      "type": "string",
      "description": "Keperluan/agenda kunjungan"
    },
    "ingin_bertemu": {
      "type": "string",
      "description": "Nama pegawai yang ingin ditemui (Dinas/Sekolah Lain)"
    },
    "ingin_bertemu_pegawai_id": {
      "type": "string",
      "description": "ID pegawai (Guru) yang ingin ditemui"
    },
    "alamat_instansi": {
      "type": "string",
      "description": "Alamat instansi (Tamu Dinas)"
    },
    "nama_sekolah": {
      "type": "string",
      "description": "Nama sekolah asal (Tamu Sekolah Lain)"
    },
    "alamat_sekolah": {
      "type": "string",
      "description": "Alamat sekolah asal (Tamu Sekolah Lain)"
    },
    "no_identitas": {
      "type": "string",
      "description": "No Identitas KTP/SIM (Tamu Umum)"
    },
    "alamat": {
      "type": "string",
      "description": "Alamat lengkap (Tamu Umum)"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa (Tamu Orang Tua/Wali)"
    },
    "nama_siswa": {
      "type": "string",
      "description": "Nama siswa (auto dari data siswa)"
    },
    "nama_kelas": {
      "type": "string",
      "description": "Kelas siswa (auto dari data siswa)"
    },
    "nama_ortu_wali": {
      "type": "string",
      "description": "Nama orang tua/wali (auto dari data siswa, dapat diedit)"
    },
    "hubungan_ortu": {
      "type": "string",
      "enum": [
        "Ayah",
        "Ibu",
        "Wali"
      ],
      "description": "Hubungan dengan siswa"
    },
    "alamat_rumah": {
      "type": "string",
      "description": "Alamat rumah (auto dari data siswa, dapat diedit)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Berkunjung",
        "Selesai"
      ],
      "default": "Berkunjung",
      "description": "Status kunjungan"
    },
    "tanggal_keluar": {
      "type": "string",
      "description": "Timestamp (ISO) saat tamu selesai/keluar"
    },
    "tahun_ajaran": {
      "type": "string"
    }
  },
  "required": [
    "tanggal",
    "jenis_tamu",
    "keperluan"
  ]
}