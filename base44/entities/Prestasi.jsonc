{
  "name": "Prestasi",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pencapaian prestasi"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "kelas_id": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "jenis_prestasi": {
      "type": "string",
      "enum": [
        "Akademik",
        "Non-Akademik"
      ],
      "description": "Jenis prestasi"
    },
    "kategori": {
      "type": "string",
      "enum": [
        "Juara 1",
        "Juara 2",
        "Juara 3",
        "Finalis",
        "Peserta"
      ],
      "description": "Kategori pencapaian"
    },
    "nama_prestasi": {
      "type": "string",
      "description": "Nama prestasi/lomba/kegiatan"
    },
    "tingkat": {
      "type": "string",
      "enum": [
        "Sekolah",
        "Kecamatan",
        "Kabupaten",
        "Provinsi",
        "Nasional",
        "Internasional"
      ],
      "description": "Tingkat prestasi"
    },
    "penyelenggara": {
      "type": "string",
      "description": "Penyelenggara kegiatan"
    },
    "keterangan": {
      "type": "string",
      "description": "Keterangan tambahan"
    },
    "file_sertifikat": {
      "type": "string",
      "description": "URL file sertifikat"
    }
  },
  "required": [
    "tanggal",
    "siswa_id",
    "nama_siswa",
    "jenis_prestasi",
    "nama_prestasi"
  ]
}