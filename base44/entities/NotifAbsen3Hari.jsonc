{
  "name": "NotifAbsen3Hari",
  "type": "object",
  "properties": {
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Sakit",
        "Izin",
        "Alfa"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "red"
      ],
      "description": "Status absensi pemicu (dihitung per status masing-masing)"
    },
    "kriteria": {
      "type": "string",
      "enum": [
        "Beruntun 3 Hari",
        "Akumulasi 3 Hari/Minggu",
        "Sama Hari 3 Minggu"
      ],
      "enumColors": [
        "red",
        "yellow",
        "purple"
      ],
      "description": "Ketentuan yang terpenuhi"
    },
    "detail": {
      "type": "string",
      "description": "Rincian tanggal/hari pemicu"
    },
    "minggu_key": {
      "type": "string",
      "description": "Kunci minggu sekolah pemicu (cth: 2026-42) \u2014 kunci deduplikasi"
    },
    "tanggal_pemicu": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir yang melengkapi kriteria"
    },
    "dicek_at": {
      "type": "string",
      "description": "Timestamp ISO pemeriksaan terakhir untuk pemicu ini"
    },
    "wa_terkirim": {
      "type": "boolean",
      "default": false,
      "description": "WA gateway berhasil terkirim ke minimal satu penerima"
    },
    "email_terkirim": {
      "type": "boolean",
      "default": false,
      "description": "Email gateway berhasil terkirim ke minimal satu penerima (riwayat lama)"
    },
    "penerima_wa": {
      "type": "string",
      "description": "Ringkasan nama penerima WA yang berhasil (wali kelas / waka)"
    },
    "penerima_email": {
      "type": "string",
      "description": "Nama penerima email (riwayat lama)"
    },
    "penerima_wa_detail": {
      "type": "array",
      "description": "Status pengiriman WA terpisah per penerima (Wali Kelas, Waka Kesiswaan, Waka Kurikulum) agar keberhasilan satu penerima tidak menutupi kegagalan penerima lain",
      "items": {
        "type": "object",
        "properties": {
          "peran": {
            "type": "string",
            "description": "Peran penerima: Wali Kelas / Waka Kesiswaan / Waka Kurikulum"
          },
          "nama": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "terkirim": {
            "type": "boolean",
            "default": false
          },
          "waktu": {
            "type": "string",
            "description": "Timestamp ISO saat WA berhasil terkirim"
          },
          "catatan": {
            "type": "string",
            "description": "Alasan bila belum terkirim (tanpa nomor, gateway mati, gagal kirim, dsb)"
          }
        }
      }
    }
  },
  "required": [
    "siswa_id",
    "nama_siswa",
    "status",
    "kriteria",
    "minggu_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}