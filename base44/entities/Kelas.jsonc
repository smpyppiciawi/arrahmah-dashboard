{
  "name": "Kelas",
  "type": "object",
  "properties": {
    "nama_kelas": {
      "type": "string",
      "description": "Nama kelas (contoh: 7A, 8B, 9C)"
    },
    "tingkat": {
      "type": "string",
      "enum": [
        "7",
        "8",
        "9"
      ],
      "description": "Tingkat kelas"
    },
    "wali_kelas": {
      "type": "string",
      "description": "Nama wali kelas"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran (contoh: 2024/2025)"
    }
  },
  "required": [
    "nama_kelas",
    "tingkat"
  ]
}