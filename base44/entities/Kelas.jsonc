{
  "name": "Kelas",
  "type": "object",
  "properties": {
    "nama_kelas": {
      "type": "string",
      "description": "Nama kelas (contoh: 7A, 8B, 9C)"
    },
    "tingkat": {
      "type": "string",
      "enum": [
        "7",
        "8",
        "9"
      ],
      "description": "Tingkat kelas"
    },
    "wali_kelas": {
      "type": "string",
      "description": "Nama wali kelas (snapshot display \u2014 kunci relasi sebenarnya di wali_kelas_id)"
    },
    "wali_kelas_id": {
      "type": "string",
      "description": "ID record Guru/pegawai yang menjadi wali kelas (kunci relasi utama \u2014 tidak berubah walau gelar/nama pegawai diperbarui)"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran (contoh: 2024/2025)"
    }
  },
  "required": [
    "nama_kelas",
    "tingkat"
  ]
}