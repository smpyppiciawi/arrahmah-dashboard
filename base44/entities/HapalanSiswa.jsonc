{
  "name": "HapalanSiswa",
  "type": "object",
  "properties": {
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "kelas_id": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "tingkat": {
      "type": "string",
      "enum": [
        "7",
        "8",
        "9"
      ]
    },
    "hapalan_item_id": {
      "type": "string",
      "description": "ID HapalanItem yang dihapal"
    },
    "nama_item": {
      "type": "string",
      "description": "Nama surah/doa"
    },
    "jenis": {
      "type": "string",
      "enum": [
        "Surah",
        "Doa"
      ]
    },
    "sudah_hapal": {
      "type": "boolean",
      "default": false,
      "description": "Status sudah hapal"
    },
    "tanggal_setor": {
      "type": "string",
      "format": "date",
      "description": "Tanggal setor/validasi hapalan"
    },
    "validator_id": {
      "type": "string",
      "description": "ID guru yang memvalidasi"
    },
    "validator_nama": {
      "type": "string",
      "description": "Nama guru yang memvalidasi"
    },
    "tahun_ajaran": {
      "type": "string"
    }
  },
  "required": [
    "siswa_id",
    "nama_siswa",
    "hapalan_item_id",
    "nama_item",
    "jenis"
  ]
}