{
  "name": "Improvement",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal improvement dilakukan"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string",
      "description": "Nama siswa"
    },
    "kelas_id": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "kategori": {
      "type": "string",
      "enum": [
        "Akademik",
        "Perilaku",
        "Kepedulian",
        "Kebersihan",
        "Lainnya"
      ],
      "default": "Perilaku",
      "description": "Kategori improvement"
    },
    "uraian": {
      "type": "string",
      "description": "Uraian aktivitas improvement"
    },
    "poin_pengurangan": {
      "type": "number",
      "description": "Poin pengurangan dari akumulatif pelanggaran"
    },
    "limit_mingguan": {
      "type": "number",
      "default": 30,
      "description": "Batas maksimal poin pengurangan per minggu (bisa custom per record)"
    },
    "minggu_key": {
      "type": "string",
      "description": "Kunci minggu ISO (cth: 2026-34) untuk validasi limit mingguan"
    },
    "validator_id": {
      "type": "string",
      "description": "ID guru/validator yang mencatat"
    },
    "validator_nama": {
      "type": "string",
      "description": "Nama validator"
    },
    "tahun_ajaran": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Dibatalkan"
      ],
      "default": "Aktif",
      "description": "Status record improvement"
    },
    "catatan": {
      "type": "string",
      "description": "Catatan tambahan"
    }
  },
  "required": [
    "tanggal",
    "siswa_id",
    "nama_siswa",
    "uraian",
    "poin_pengurangan"
  ]
}