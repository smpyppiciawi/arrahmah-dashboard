{
  "name": "Improvement",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal improvement dilakukan"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string",
      "description": "Nama siswa"
    },
    "kelas_id": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "kegiatan_pembinaan_id": {
      "type": "string",
      "description": "ID KegiatanPembinaan yang dipilih"
    },
    "kegiatan_pembinaan_nama": {
      "type": "string",
      "description": "Nama kegiatan pembinaan (auto dari Sheet 3)"
    },
    "kategori": {
      "type": "string",
      "enum": [
        "Akademik",
        "Perilaku",
        "Kepedulian",
        "Kebersihan",
        "Lainnya"
      ],
      "default": "Perilaku",
      "description": "Kategori improvement"
    },
    "uraian": {
      "type": "string",
      "description": "Uraian aktivitas improvement"
    },
    "poin_pengurangan": {
      "type": "number",
      "description": "Poin pengurangan dari akumulatif pelanggaran (auto dari kegiatan, dapat diedit; untuk Sesuai Penetapan default 0)"
    },
    "sesuai_penetapan": {
      "type": "boolean",
      "default": false,
      "description": "True jika kegiatan pembinaan berpoin Sesuai Penetapan"
    },
    "limit_mingguan": {
      "type": "number",
      "default": 30,
      "description": "Batas maksimal poin pengurangan per minggu (auto dari universal, atau manual jika universal off)"
    },
    "limit_universal_applied": {
      "type": "boolean",
      "default": true,
      "description": "True jika limit diambil dari universal setting"
    },
    "minggu_key": {
      "type": "string",
      "description": "Kunci minggu ISO (cth: 2026-34) untuk validasi limit mingguan"
    },
    "validator_id": {
      "type": "string",
      "description": "ID guru/validator yang mencatat"
    },
    "validator_nama": {
      "type": "string",
      "description": "Nama validator"
    },
    "tahun_ajaran": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Dibatalkan"
      ],
      "default": "Aktif",
      "description": "Status record improvement"
    },
    "catatan": {
      "type": "string",
      "description": "Catatan tambahan"
    },
    "foto_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foto bukti kegiatan improvement (URL publik, otomatis terkompresi; bisa lebih dari 1)"
    }
  },
  "required": [
    "tanggal",
    "siswa_id",
    "nama_siswa",
    "poin_pengurangan"
  ]
}