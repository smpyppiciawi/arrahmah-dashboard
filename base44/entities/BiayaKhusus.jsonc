{
  "name": "BiayaKhusus",
  "type": "object",
  "properties": {
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nama_siswa": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "tarif_iuran_id": {
      "type": "string",
      "description": "ID tarif iuran yang dimodifikasi"
    },
    "nama_iuran": {
      "type": "string"
    },
    "nominal_khusus": {
      "type": "number",
      "description": "Nominal khusus untuk siswa ini (0 jika gratis)"
    },
    "sudah_bayar": {
      "type": "number",
      "default": 0,
      "description": "Nominal yang sudah dibayarkan (untuk iuran Mutasi/PPDB)"
    },
    "is_gratis": {
      "type": "boolean",
      "default": false,
      "description": "True jika iuran ini digratiskan"
    },
    "kategori": {
      "type": "string",
      "enum": [
        "Yatim/Yatim Piatu Full",
        "Yatim",
        "Kurang Mampu",
        "Beasiswa Yayasan",
        "Prestasi",
        "Lainnya"
      ],
      "default": "Yatim",
      "description": "Kategori keringanan"
    },
    "gratis_bulan_spp": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bulan SPP yang digratiskan (untuk kategori Prestasi)"
    },
    "keterangan": {
      "type": "string"
    },
    "tahun_ajaran": {
      "type": "string"
    }
  },
  "required": [
    "siswa_id",
    "nama_siswa",
    "tarif_iuran_id"
  ]
}