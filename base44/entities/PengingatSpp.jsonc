{
  "name": "PengingatSpp",
  "type": "object",
  "properties": {
    "siswa_id": {
      "type": "string",
      "description": "ID siswa penerima pengingat"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Nomor WhatsApp orang tua/wali tujuan"
    },
    "bulan": {
      "type": "string",
      "description": "Bulan SPP yang ditagihkan (Januari-Desember)"
    },
    "bulan_key": {
      "type": "string",
      "description": "Kunci deduplikasi pengingat, contoh: 2026-10 (satu pengingat per siswa per bulan)"
    },
    "tahun_ajaran": {
      "type": "string"
    },
    "nominal": {
      "type": "number",
      "default": 0,
      "description": "Nominal SPP yang ditagihkan"
    },
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pengingat dikirim"
    },
    "wa_terkirim": {
      "type": "boolean",
      "default": false,
      "description": "True = WhatsApp pengingat berhasil terkirim"
    }
  },
  "required": [
    "siswa_id",
    "bulan_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}