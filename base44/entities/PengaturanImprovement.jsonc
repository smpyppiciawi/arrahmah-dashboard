{
  "name": "PengaturanImprovement",
  "type": "object",
  "properties": {
    "limit_mingguan_universal": {
      "type": "number",
      "default": 30,
      "description": "Limit mingguan universal untuk pengurangan poin (berlaku semua siswa jika limit_universal_aktif = true)"
    },
    "limit_universal_aktif": {
      "type": "boolean",
      "default": true,
      "description": "Switch ON = universal (sekali isi untuk seluruh siswa); OFF = manual per record di form Tambah Improvement"
    },
    "pelanggaran_module_aktif": {
      "type": "boolean",
      "default": true,
      "description": "Aktif/Nonaktif modul Pelanggaran lama. Jika false, tab Pelanggaran disembunyikan dan sistem beralih ke Improvement."
    },
    "akumulasi_poin_lama_aktif": {
      "type": "boolean",
      "default": false,
      "description": "Switch ON = Poin Pelanggaran Lama (modul Pelanggaran lama) diakumulasi dengan Poin Pelanggaran Baru (PelanggaranImprovement) dan masuk ke Poin Bersih. Catatan pelanggaran lama tetap ditampilkan di Cari Record Siswa tab Improvement, disatukan dengan yang baru."
    },
    "rapor_kuning_poin": {
      "type": "number",
      "default": 300,
      "description": "Batas akumulasi poin bersih untuk memperoleh Status Rapor Kuning"
    },
    "rapor_merah_poin": {
      "type": "number",
      "default": 600,
      "description": "Batas akumulasi poin bersih untuk memperoleh Status Rapor Merah"
    },
    "rapor_hitam_poin": {
      "type": "number",
      "default": 1000,
      "description": "Batas akumulasi poin bersih untuk memperoleh Status Rapor Hitam"
    },
    "rapor_naik_kuning_merah_poin": {
      "type": "number",
      "default": 100,
      "description": "Tambahan poin pelanggaran baru selama masa Rapor Kuning yang menaikkan status menjadi Rapor Merah"
    },
    "rapor_naik_merah_hitam_poin": {
      "type": "number",
      "default": 100,
      "description": "Tambahan poin pelanggaran baru selama masa Rapor Merah yang menaikkan status menjadi Rapor Hitam"
    },
    "rapor_kuning_hari": {
      "type": "number",
      "default": 40,
      "description": "Masa berlaku Status Rapor Kuning dalam hari kalender"
    },
    "rapor_merah_hari": {
      "type": "number",
      "default": 120,
      "description": "Masa berlaku Status Rapor Merah dalam hari kalender"
    },
    "rapor_mode_kenaikan": {
      "type": "string",
      "enum": [
        "Otomatis",
        "Persetujuan"
      ],
      "default": "Otomatis",
      "description": "Otomatis = kenaikan status langsung diterapkan sistem setelah batas poin tercapai; Persetujuan = kenaikan menjadi permintaan tertunda yang harus disetujui admin/kesiswaan/kurikulum"
    },
    "tahun_ajaran": {
      "type": "string"
    },
    "keterangan": {
      "type": "string"
    }
  },
  "required": [
    "limit_mingguan_universal"
  ]
}