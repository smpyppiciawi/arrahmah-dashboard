{
  "name": "DataWajah",
  "type": "object",
  "properties": {
    "person_type": {
      "type": "string",
      "enum": [
        "Siswa",
        "Pegawai"
      ],
      "description": "Tipe pemilik data wajah"
    },
    "person_id": {
      "type": "string",
      "description": "ID siswa atau pegawai"
    },
    "nama": {
      "type": "string",
      "description": "Nama pemilik wajah"
    },
    "nip_nis": {
      "type": "string",
      "description": "NIS atau NIP"
    },
    "info": {
      "type": "string",
      "description": "Kelas atau jabatan"
    },
    "descriptor": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "128-dimension face embedding dari face-api.js"
    },
    "card_id_virtual": {
      "type": "string",
      "description": "Virtual card ID untuk KartuAbsensi (FACE-{person_id})"
    },
    "foto_url": {
      "type": "string",
      "description": "URL foto wajah hasil upload"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Nonaktif"
      ],
      "default": "Aktif"
    }
  },
  "required": [
    "person_type",
    "person_id",
    "nama",
    "descriptor"
  ]
}