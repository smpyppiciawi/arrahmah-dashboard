{
  "name": "SiswaSPMB",
  "type": "object",
  "properties": {
    "reg_number": {
      "type": "string",
      "description": "Nomor pendaftaran SPMB (kunci unik pendaftar)"
    },
    "spmb_student_id": {
      "type": "string",
      "description": "ID record lama (arsip) \u2014 tidak dipakai lagi pada alur internal"
    },
    "nama": {
      "type": "string",
      "description": "Nama lengkap pendaftar"
    },
    "nickname": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Laki-laki",
        "Perempuan"
      ],
      "description": "Jenis kelamin"
    },
    "nisn": {
      "type": "string"
    },
    "nik": {
      "type": "string"
    },
    "birth_place": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "religion": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "rt": {
      "type": "string"
    },
    "rw": {
      "type": "string"
    },
    "village": {
      "type": "string",
      "description": "Kelurahan/Desa"
    },
    "district": {
      "type": "string",
      "description": "Kecamatan"
    },
    "city": {
      "type": "string",
      "description": "Kota/Kabupaten"
    },
    "province": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "registration_officer": {
      "type": "string",
      "description": "Nama petugas pendaftaran yang menerima berkas"
    },
    "gelombang_id": {
      "type": "string",
      "description": "ID GelombangSPMB yang dipilih saat pendaftaran"
    },
    "biaya_tertagih": {
      "type": "number",
      "default": 0,
      "description": "Biaya pendaftaran sesuai gelombang saat pendaftaran"
    },
    "wave": {
      "type": "string",
      "description": "Nama gelombang pendaftaran (Gelombang 1 / Gelombang 2)"
    },
    "registration_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "accepted",
        "tarik_berkas",
        "undur_diri"
      ],
      "description": "Status pendaftaran"
    },
    "payment_status": {
      "type": "string",
      "description": "Status pembayaran pendaftar"
    },
    "interview_status": {
      "type": "string",
      "description": "Status wawancara (belum/lulus/tidak_lulus)"
    },
    "interview_date": {
      "type": "string",
      "description": "Tanggal wawancara"
    },
    "interview_officer": {
      "type": "string",
      "description": "Petugas penguji wawancara"
    },
    "interview_notes": {
      "type": "string",
      "description": "Catatan hasil wawancara"
    },
    "interview_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no": {
            "type": "string",
            "description": "Kode pertanyaan (q1, q2, ...)"
          },
          "jawaban": {
            "type": "string"
          }
        }
      },
      "description": "Jawaban kuesioner wawancara SPMB"
    },
    "father_name": {
      "type": "string"
    },
    "father_phone": {
      "type": "string"
    },
    "father_job": {
      "type": "string"
    },
    "mother_name": {
      "type": "string"
    },
    "mother_phone": {
      "type": "string"
    },
    "mother_job": {
      "type": "string"
    },
    "guardian_name": {
      "type": "string"
    },
    "guardian_phone": {
      "type": "string"
    },
    "previous_school": {
      "type": "string",
      "description": "Sekolah asal"
    },
    "photo_url": {
      "type": "string",
      "description": "URL foto pendaftar"
    },
    "doc_birth_certificate": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: Akta Kelahiran"
    },
    "doc_family_card": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: Kartu Keluarga"
    },
    "doc_ktp_father": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: KTP Ayah"
    },
    "doc_ktp_mother": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: KTP Ibu"
    },
    "doc_photo_3x4": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: Foto 3x4"
    },
    "doc_ijazah": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: Ijazah SD/MI"
    },
    "doc_skhun": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: SKHUN"
    },
    "doc_nisn_card": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: Kartu NISN"
    },
    "doc_kip": {
      "type": "boolean",
      "default": false,
      "description": "Berkas: KIP (jika ada)"
    },
    "pembayaran": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "payment_id": {
            "type": "string",
            "description": "ID unik pembayaran (anti-dobel)"
          },
          "tanggal": {
            "type": "string"
          },
          "jenis": {
            "type": "string",
            "description": "Jenis pembiayaan"
          },
          "nominal": {
            "type": "number"
          },
          "catatan": {
            "type": "string"
          },
          "keuangan_id": {
            "type": "string",
            "description": "ID transaksi Keuangan terkait"
          }
        }
      },
      "description": "Riwayat pembayaran SPMB pendaftar ini + tautan transaksi buku kas"
    },
    "total_dibayar": {
      "type": "number",
      "default": 0,
      "description": "Total pembayaran SPMB tercatat"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID Siswa aktif hasil finalisasi"
    },
    "finalized": {
      "type": "boolean",
      "default": false,
      "description": "True = pendaftar sudah difinalisasi menjadi Siswa aktif"
    },
    "finalized_at": {
      "type": "string",
      "description": "Timestamp finalisasi (ISO)"
    },
    "homevisit_id": {
      "type": "string",
      "description": "ID draf HomeVisit hasil data wawancara"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran pendaftaran"
    },
    "spmb_updated_at": {
      "type": "string",
      "description": "Timestamp perubahan terakhir"
    }
  },
  "required": [
    "reg_number",
    "nama"
  ]
}