{
  "name": "AbsensiPegawai",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal absensi"
    },
    "guru_id": {
      "type": "string",
      "description": "ID pegawai"
    },
    "nip": {
      "type": "string",
      "description": "NIP pegawai"
    },
    "nama_pegawai": {
      "type": "string",
      "description": "Nama pegawai"
    },
    "jabatan": {
      "type": "string",
      "description": "Jabatan pegawai"
    },
    "jam_masuk": {
      "type": "string",
      "description": "Jam masuk (HH:mm)"
    },
    "jam_keluar": {
      "type": "string",
      "description": "Jam keluar (HH:mm)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Hadir",
        "Terlambat",
        "Izin",
        "Sakit",
        "Alfa"
      ],
      "default": "Hadir",
      "description": "Status kehadiran"
    },
    "metode": {
      "type": "string",
      "enum": [
        "RFID",
        "QRCode",
        "Fingerprint",
        "FaceRecognition",
        "Manual"
      ],
      "default": "Manual",
      "description": "Metode absensi"
    },
    "card_id": {
      "type": "string",
      "description": "ID kartu yang digunakan"
    },
    "keterangan": {
      "type": "string"
    }
  },
  "required": [
    "tanggal",
    "guru_id",
    "nama_pegawai",
    "status"
  ]
}