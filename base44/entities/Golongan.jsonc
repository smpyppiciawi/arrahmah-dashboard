{
  "name": "Golongan",
  "type": "object",
  "properties": {
    "nama_golongan": {
      "type": "string",
      "description": "Nama golongan honorarium"
    },
    "nominal": {
      "type": "number",
      "description": "Total gaji (otomatis dihitung dari rincian)"
    },
    "rincian_gaji": {
      "type": "object",
      "description": "Rincian komponen gaji",
      "properties": {
        "gaji_pokok": {
          "type": "number",
          "default": 0
        },
        "jabatan": {
          "type": "number",
          "default": 0
        },
        "bpjs": {
          "type": "number",
          "default": 0
        },
        "t_transport": {
          "type": "number",
          "default": 0
        },
        "pembina": {
          "type": "number",
          "default": 0
        },
        "lembur": {
          "type": "number",
          "default": 0
        },
        "wali_kelas": {
          "type": "number",
          "default": 0
        },
        "pulsa": {
          "type": "number",
          "default": 0
        },
        "t_tidak_tetap": {
          "type": "number",
          "default": 0
        },
        "pensiun": {
          "type": "number",
          "default": 0
        }
      }
    },
    "keterangan": {
      "type": "string"
    }
  },
  "required": [
    "nama_golongan",
    "nominal"
  ]
}