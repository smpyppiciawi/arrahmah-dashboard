{
  "name": "DataLulusan",
  "type": "object",
  "properties": {
    "nis": {
      "type": "string",
      "description": "Nomor Induk Siswa"
    },
    "nama": {
      "type": "string",
      "description": "Nama lengkap siswa"
    },
    "jenis_kelamin": {
      "type": "string",
      "enum": [
        "Laki-laki",
        "Perempuan"
      ]
    },
    "tanggal_lahir": {
      "type": "string",
      "format": "date"
    },
    "alamat": {
      "type": "string"
    },
    "nama_ortu": {
      "type": "string",
      "description": "Nama orang tua/wali"
    },
    "no_telp_ortu": {
      "type": "string"
    },
    "kelas_terakhir": {
      "type": "string",
      "description": "Nama kelas terakhir siswa sebelum lulus"
    },
    "tahun_lulus": {
      "type": "string",
      "description": "Tahun ajaran saat lulus (contoh: 2024/2025)"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa asli untuk relasi data riwayat"
    },
    "status": {
      "type": "string",
      "enum": [
        "Lulus",
        "Pindah",
        "Keluar"
      ],
      "default": "Lulus"
    },
    "keterangan": {
      "type": "string"
    },
    "jenis_sekolah_lanjutan": {
      "type": "string",
      "enum": [
        "SMA",
        "SMK",
        "MA",
        "PONPES"
      ],
      "description": "Jenis sekolah lanjutan"
    },
    "nama_sekolah_lanjutan": {
      "type": "string",
      "description": "Nama sekolah lanjutan"
    },
    "npsn_sekolah_lanjutan": {
      "type": "string",
      "description": "NPSN sekolah lanjutan"
    },
    "alamat_sekolah_lanjutan": {
      "type": "string",
      "description": "Alamat sekolah lanjutan"
    }
  },
  "required": [
    "nis",
    "nama",
    "tahun_lulus"
  ]
}