{
  "name": "Guru",
  "type": "object",
  "properties": {
    "nuptk": {
      "type": "string",
      "description": "NUPTK / NIP / NIK pegawai (nomor sama dengan NIP sebelumnya, hanya nama isian yang berubah)"
    },
    "nrks": {
      "type": "string",
      "description": "NRKS (Nomor Register Kepala Sekolah) \u2014 khusus jabatan Kepala Sekolah. Otomatis dipakai sebagai nomor Kepala Sekolah pada tanda tangan Surat, Rapor & Legger."
    },
    "nama": {
      "type": "string",
      "description": "Nama lengkap guru/pegawai (hasil gabungan Gelar Depan + Nama + Gelar Belakang \u2014 dipakai seluruh sistem termasuk Rapor & Legger)"
    },
    "gelar_depan": {
      "type": "string",
      "description": "Gelar depan (contoh: H., Hj., Dr.) \u2014 digabung otomatis ke Nama Lengkap saat disimpan"
    },
    "gelar_belakang": {
      "type": "string",
      "description": "Gelar belakang (contoh: S.Pd., M.Pd.) \u2014 digabung otomatis ke Nama Lengkap saat disimpan"
    },
    "jenis_kelamin": {
      "type": "string",
      "enum": [
        "Laki-laki",
        "Perempuan"
      ]
    },
    "jabatan": {
      "type": "string",
      "enum": [
        "Guru Mata Pelajaran",
        "Kepala Sekolah",
        "Tata Usaha",
        "Yayasan",
        "DKM",
        "Madrasah",
        "Lainnya"
      ],
      "default": "Guru Mata Pelajaran",
      "description": "Jabatan pegawai"
    },
    "tugas_tambahan": {
      "type": "string",
      "description": "Tugas tambahan guru (nilai bebas)"
    },
    "mapel": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mata pelajaran yang diampu (untuk Guru)"
    },
    "no_telp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "foto_url": {
      "type": "string",
      "description": "URL foto profil guru/pegawai"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Cuti",
        "Pensiun"
      ],
      "default": "Aktif"
    },
    "golongan_id": {
      "type": "string",
      "description": "ID golongan honorarium"
    },
    "nama_golongan": {
      "type": "string",
      "description": "Nama golongan honorarium"
    },
    "nominal_gaji": {
      "type": "number",
      "description": "Nominal gaji/honorarium berdasarkan golongan"
    },
    "rincian_gaji": {
      "type": "object",
      "description": "Rincian komponen gaji per pegawai (boleh berbeda dari template golongan)",
      "properties": {
        "gaji_pokok": {
          "type": "number",
          "default": 0
        },
        "jabatan": {
          "type": "number",
          "default": 0
        },
        "bpjs": {
          "type": "number",
          "default": 0
        },
        "t_transport": {
          "type": "number",
          "default": 0
        },
        "pembina": {
          "type": "number",
          "default": 0
        },
        "lembur": {
          "type": "number",
          "default": 0
        },
        "wali_kelas": {
          "type": "number",
          "default": 0
        },
        "pulsa": {
          "type": "number",
          "default": 0
        },
        "t_tidak_tetap": {
          "type": "number",
          "default": 0
        },
        "pensiun": {
          "type": "number",
          "default": 0
        }
      }
    },
    "data_anak": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nama": {
            "type": "string"
          },
          "tanggal_lahir": {
            "type": "string"
          },
          "jenis_kelamin": {
            "type": "string"
          },
          "pendidikan": {
            "type": "string"
          }
        }
      },
      "description": "Data anak guru"
    },
    "riwayat_pendidikan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jenjang": {
            "type": "string"
          },
          "nama_institusi": {
            "type": "string"
          },
          "jurusan": {
            "type": "string"
          },
          "tahun_lulus": {
            "type": "string"
          }
        }
      },
      "description": "Riwayat pendidikan guru"
    }
  },
  "required": [
    "nama"
  ]
}