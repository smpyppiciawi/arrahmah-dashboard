{
  "name": "PengaturanAplikasi",
  "type": "object",
  "properties": {
    "tahun_ajaran_aktif": {
      "type": "string",
      "description": "Tahun ajaran yang sedang aktif, contoh: 2025/2026"
    },
    "nama_sekolah": {
      "type": "string",
      "description": "Nama sekolah"
    },
    "keterangan": {
      "type": "string",
      "description": "Keterangan tambahan"
    },
    "spmb_menu_aktif": {
      "type": "boolean",
      "default": true,
      "description": "ON = Menu SPMB tampil di navigasi seluruh akun; OFF = Menu SPMB disembunyikan dari navigasi (akses langsung ke halaman tetap berjalan). Hanya diatur oleh Admin di Pengaturan."
    },
    "tampilkan_status_kehadiran_piket": {
      "type": "boolean",
      "default": true,
      "description": "Tampilkan status kehadiran petugas piket di Dashboard (diatur Admin/TU)"
    },
    "backfill_aktif": {
      "type": "boolean",
      "default": true,
      "description": "Master switch fitur Backfill Alfa & auto-pelanggaran Alfa. False = tombol Backfill dinonaktifkan DAN workflow 'Pelanggaran Otomatis Alfa' dijeda (tidak ada pelanggaran otomatis dari status Alfa sama sekali)."
    },
    "tka_tampil_beranda": {
      "type": "boolean",
      "default": false,
      "description": "ON = Nilai TKA tampil pada Beranda Akun Siswa; OFF = tidak tampil. Diatur dari Tab TKA pada Menu Nilai."
    },
    "kkm_pts": {
      "type": "number",
      "default": 75,
      "description": "KKM PTS untuk seluruh mapel (diatur pada Tab KKM di Pengaturan PTS, Menu Nilai > PTS). Dipakai untuk kolom KKM Rapor LHBS, status Tuntas/Belum Tuntas, dan perhitungan Predikat PTS."
    },
    "format_nilai_akhir": {
      "type": "number",
      "default": 1,
      "description": "Format Nilai Akhir yang aktif (GLOBAL seluruh sekolah, hanya 1 yang aktif): 1 = 70% Rerata Nilai Harian + 30% Rerata Nilai Ujian; 2 = 75% + 25%; 3 = 60% + 40%. Nilai Akhir Rapor dibulatkan ke atas."
    },
    "notif_siswa_absensi": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Siswa: notifikasi absensi siswa ke WhatsApp orang tua/wali."
    },
    "notif_siswa_absen3": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Siswa: peringatan absen 3 hari (WhatsApp)."
    },
    "notif_siswa_spp": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Siswa: pengingat tagihan iuran SPP setiap tanggal 10 bagi siswa yang belum membayar SPP bulan berjalan (WhatsApp orang tua/wali)."
    },
    "notif_siswa_catatan": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Siswa: pemberitahuan catatan siswa UKS/Izin (manual, tombol Kirim Orang Tua) ke WhatsApp orang tua/wali."
    },
    "notif_pegawai_absensi": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Pegawai: notifikasi absensi pegawai (WhatsApp & Email)."
    },
    "notif_pegawai_kalender": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Pegawai: pengingat kegiatan Kalender Akademik H-2 (Email)."
    },
    "notif_pegawai_tamu": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Pegawai: pemberitahuan tamu Buku Tamu yang ingin bertemu pegawai terkait (WhatsApp)."
    },
    "notif_pegawai_catatan": {
      "type": "boolean",
      "default": true,
      "description": "Notifikasi Gateway \u2014 Pegawai: pemberitahuan catatan siswa UKS/Izin (manual, tombol Kirim Wali Kelas) ke WhatsApp wali kelas."
    },
    "notif_wa_siswa": {
      "type": "boolean",
      "default": true,
      "description": "Lama \u2014 digantikan sakelar per fitur (notif_siswa_absensi & kawan-kawan). Dipertahankan agar workflow lama tetap berjalan."
    },
    "notif_wa_pegawai": {
      "type": "boolean",
      "default": true,
      "description": "Lama \u2014 dipakai workflow Pengingat Tugas H-1 Pegawai. Dipertahankan agar workflow tetap berjalan."
    },
    "notif_wa_lainnya": {
      "type": "boolean",
      "default": true,
      "description": "Lama \u2014 tidak dipakai lagi."
    },
    "notif_email_siswa": {
      "type": "boolean",
      "default": true,
      "description": "Lama \u2014 tidak dipakai lagi (kanal siswa hanya WhatsApp)."
    },
    "notif_email_pegawai": {
      "type": "boolean",
      "default": true,
      "description": "Lama \u2014 dipakai workflow Pengingat Kalender H-2 bila sakelar baru belum diatur."
    },
    "notif_email_lainnya": {
      "type": "boolean",
      "default": true,
      "description": "Lama \u2014 tidak dipakai lagi."
    }
  },
  "required": [
    "tahun_ajaran_aktif"
  ]
}