{
  "name": "PengaturanAplikasi",
  "type": "object",
  "properties": {
    "tahun_ajaran_aktif": {
      "type": "string",
      "description": "Tahun ajaran yang sedang aktif, contoh: 2025/2026"
    },
    "nama_sekolah": {
      "type": "string",
      "description": "Nama sekolah"
    },
    "keterangan": {
      "type": "string",
      "description": "Keterangan tambahan"
    },
    "tampilkan_status_kehadiran_piket": {
      "type": "boolean",
      "default": true,
      "description": "Tampilkan status kehadiran petugas piket di Dashboard (diatur Admin/TU)"
    },
    "backfill_aktif": {
      "type": "boolean",
      "default": true,
      "description": "Master switch fitur Backfill Alfa & auto-pelanggaran Alfa. False = tombol Backfill dinonaktifkan DAN workflow 'Pelanggaran Otomatis Alfa' dijeda (tidak ada pelanggaran otomatis dari status Alfa sama sekali)."
    },
    "tka_tampil_beranda": {
      "type": "boolean",
      "default": false,
      "description": "ON = Nilai TKA tampil pada Beranda Akun Siswa; OFF = tidak tampil. Diatur dari Tab TKA pada Menu Nilai."
    },
    "kkm_pts": {
      "type": "number",
      "default": 75,
      "description": "KKM PTS untuk seluruh mapel (diatur pada Tab KKM di Pengaturan PTS, Menu Nilai > PTS). Dipakai untuk kolom KKM Rapor LHBS, status Tuntas/Belum Tuntas, dan perhitungan Predikat PTS."
    },
    "format_nilai_akhir": {
      "type": "number",
      "default": 1,
      "description": "Format Nilai Akhir yang aktif (GLOBAL seluruh sekolah, hanya 1 yang aktif): 1 = 70% Rerata Nilai Harian + 30% Rerata Nilai Ujian; 2 = 75% + 25%; 3 = 60% + 40%. Nilai Akhir Rapor dibulatkan ke atas."
    }
  },
  "required": [
    "tahun_ajaran_aktif"
  ]
}