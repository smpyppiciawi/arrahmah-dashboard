{
  "name": "Absensi",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal absensi"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "kelas_id": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Hadir",
        "Sakit",
        "Izin",
        "Alfa",
        "Terlambat",
        "Libur"
      ],
      "default": "Hadir",
      "description": "Status kehadiran. Libur = hari libur sekolah, dihitung sebagai Hadir."
    },
    "jenis_absensi": {
      "type": "string",
      "enum": [
        "Kehadiran",
        "Jumat"
      ],
      "default": "Kehadiran",
      "description": "Jenis absensi"
    },
    "jam_masuk": {
      "type": "string",
      "description": "Jam masuk (format HH:mm)"
    },
    "metode": {
      "type": "string",
      "enum": [
        "RFID",
        "QRCode",
        "Fingerprint",
        "FaceRecognition",
        "Manual"
      ],
      "default": "Manual",
      "description": "Metode absensi"
    },
    "card_id": {
      "type": "string",
      "description": "ID kartu yang digunakan"
    },
    "keterangan": {
      "type": "string"
    }
  },
  "required": [
    "tanggal",
    "siswa_id",
    "nama_siswa",
    "nama_kelas",
    "status"
  ]
}