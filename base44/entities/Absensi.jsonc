{
  "name": "Absensi",
  "type": "object",
  "properties": {
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal absensi"
    },
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "kelas_id": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Hadir",
        "Sakit",
        "Izin",
        "Alfa",
        "Terlambat"
      ],
      "default": "Hadir"
    },
    "jam_masuk": {
      "type": "string",
      "description": "Jam masuk (format HH:mm)"
    },
    "keterangan": {
      "type": "string"
    }
  },
  "required": [
    "tanggal",
    "siswa_id",
    "nama_siswa",
    "nama_kelas",
    "status"
  ]
}