{
  "name": "HistoryStatusSiswa",
  "type": "object",
  "properties": {
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string"
    },
    "nama_siswa": {
      "type": "string"
    },
    "nama_kelas": {
      "type": "string",
      "description": "Nama kelas pada tahun ajaran tersebut"
    },
    "tingkat": {
      "type": "string",
      "description": "Tingkat kelas pada tahun ajaran tersebut"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran (cth: 2026/2027)"
    },
    "status_akhir": {
      "type": "string",
      "enum": [
        "Aktif",
        "Lulus",
        "Pindah",
        "Keluar"
      ],
      "description": "Status akhir siswa di tahun ajaran tersebut"
    },
    "tahun_lulus": {
      "type": "string",
      "description": "Tahun lulus (jika status Lulus)"
    },
    "tanggal_catat": {
      "type": "string",
      "format": "date",
      "description": "Tanggal status dicatat"
    },
    "migrate_log_id": {
      "type": "string",
      "description": "ID LogTahunAjaran terkait"
    },
    "keterangan": {
      "type": "string"
    }
  },
  "required": [
    "siswa_id",
    "nama_siswa",
    "tahun_ajaran",
    "status_akhir"
  ]
}