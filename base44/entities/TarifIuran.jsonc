{
  "name": "TarifIuran",
  "type": "object",
  "properties": {
    "nama": {
      "type": "string",
      "description": "Nama iuran (SPP, Ujian, dll)"
    },
    "jenis_iuran": {
      "type": "string",
      "enum": [
        "SPP",
        "Ujian",
        "Mutasi",
        "Awal Tahun",
        "PPDB Gel 1",
        "PPDB Gel 2"
      ],
      "default": "SPP",
      "description": "Jenis iuran untuk pengelompokan"
    },
    "nominal": {
      "type": "number",
      "description": "Nominal iuran"
    },
    "tingkat": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "7",
          "8",
          "9",
          "Semua"
        ]
      },
      "default": [
        "Semua"
      ],
      "description": "Tingkat kelas yang berlaku (bisa lebih dari 1)"
    },
    "periode": {
      "type": "string",
      "enum": [
        "Bulanan",
        "Semester",
        "Tahunan",
        "Sekali"
      ],
      "description": "Periode pembayaran"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran berlaku"
    },
    "keterangan": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Tidak Aktif"
      ],
      "default": "Aktif"
    },
    "spp_gratis_bulan_pertama": {
      "type": "boolean",
      "default": false,
      "description": "Khusus PPDB Gel 1: SPP bulan pertama (Juli) digratiskan"
    },
    "spp_juli_threshold": {
      "type": "number",
      "default": 0,
      "description": "Khusus PPDB Gel 2: ambang total pembayaran tarif ini yang membuat SPP Juli otomatis gratis (di atas ambang). 0 = pakai default 650.000."
    },
    "tipe_transaksi_id": {
      "type": "string",
      "description": "ID TipeTransaksi yang dipetakan resmi (pemetaan tarif iuran \u2192 tipe transaksi siswa). Dipakai form transaksi untuk auto-fill Tipe Transaksi."
    }
  },
  "required": [
    "nama",
    "nominal",
    "periode"
  ]
}