{
  "name": "TarifIuran",
  "type": "object",
  "properties": {
    "nama": {
      "type": "string",
      "description": "Nama iuran (SPP, Ujian, dll)"
    },
    "jenis_iuran": {
      "type": "string",
      "enum": [
        "SPP",
        "Ujian",
        "Mutasi",
        "Awal Tahun"
      ],
      "default": "SPP",
      "description": "Jenis iuran untuk pengelompokan"
    },
    "nominal": {
      "type": "number",
      "description": "Nominal iuran"
    },
    "tingkat": {
      "type": "string",
      "enum": [
        "7",
        "8",
        "9",
        "Semua"
      ],
      "default": "Semua",
      "description": "Tingkat kelas yang berlaku"
    },
    "periode": {
      "type": "string",
      "enum": [
        "Bulanan",
        "Semester",
        "Tahunan",
        "Sekali"
      ],
      "description": "Periode pembayaran"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran berlaku"
    },
    "keterangan": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktif",
        "Tidak Aktif"
      ],
      "default": "Aktif"
    }
  },
  "required": [
    "nama",
    "nominal",
    "periode"
  ]
}