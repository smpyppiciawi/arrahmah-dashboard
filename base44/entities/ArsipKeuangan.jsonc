{
  "name": "ArsipKeuangan",
  "type": "object",
  "properties": {
    "siswa_id": {
      "type": "string",
      "description": "ID siswa"
    },
    "nis": {
      "type": "string",
      "description": "NIS siswa"
    },
    "nama_siswa": {
      "type": "string",
      "description": "Nama siswa"
    },
    "nama_kelas": {
      "type": "string",
      "description": "Nama kelas saat tunggakan dicatat"
    },
    "tingkat": {
      "type": "string",
      "description": "Tingkat kelas saat tunggakan dicatat"
    },
    "tahun_ajaran_asal": {
      "type": "string",
      "description": "Tahun ajaran asal tunggakan (cth: 2026/2027)"
    },
    "nama_iuran": {
      "type": "string",
      "description": "Nama iuran yang masih tunggakan"
    },
    "jenis_iuran": {
      "type": "string",
      "enum": [
        "SPP",
        "Ujian",
        "Mutasi",
        "Awal Tahun",
        "PPDB Gel 1",
        "PPDB Gel 2",
        "Lainnya"
      ],
      "description": "Jenis iuran"
    },
    "tarif_iuran_id": {
      "type": "string",
      "description": "ID tarif iuran asal"
    },
    "biaya_khusus_id": {
      "type": "string",
      "description": "ID BiayaKhusus asal (jika ada)"
    },
    "nominal_tagihan": {
      "type": "number",
      "description": "Nominal tagihan asli"
    },
    "nominal_bayar": {
      "type": "number",
      "default": 0,
      "description": "Nominal yang sudah dibayar sebelum migrasi"
    },
    "sisa_tunggakan": {
      "type": "number",
      "description": "Sisa tunggakan yang belum dibayar (tagihan - bayar)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Belum Lunas",
        "Lunas",
        "Cicil"
      ],
      "default": "Belum Lunas",
      "description": "Status pembayaran arsip"
    },
    "kategori": {
      "type": "string",
      "description": "Kategori keringanan (jika dari BiayaKhusus)"
    },
    "migrated_at": {
      "type": "string",
      "description": "Timestamp ISO saat diarsipkan"
    },
    "migrate_log_id": {
      "type": "string",
      "description": "ID LogTahunAjaran terkait"
    }
  },
  "required": [
    "siswa_id",
    "nama_siswa",
    "tahun_ajaran_asal"
  ]
}