{
  "name": "KalenderAkademik",
  "type": "object",
  "properties": {
    "judul": {
      "type": "string",
      "description": "Judul kegiatan"
    },
    "tanggal_mulai": {
      "type": "string",
      "format": "date",
      "description": "Tanggal mulai kegiatan"
    },
    "tanggal_selesai": {
      "type": "string",
      "format": "date",
      "description": "Tanggal selesai kegiatan (opsional, jika lebih dari 1 hari)"
    },
    "kategori": {
      "type": "string",
      "enum": [
        "Hari Libur Nasional",
        "Libur Sekolah",
        "Ujian",
        "Kegiatan Sekolah",
        "Penerimaan Rapor",
        "Kegiatan Kesiswaan",
        "Lainnya"
      ],
      "description": "Kategori kegiatan"
    },
    "keterangan": {
      "type": "string",
      "description": "Keterangan tambahan"
    },
    "tahun_ajaran": {
      "type": "string",
      "description": "Tahun ajaran (contoh: 2025/2026)"
    },
    "warna": {
      "type": "string",
      "description": "Warna penanda (hex atau nama)"
    },
    "tugas_untuk_aktif": {
      "type": "boolean",
      "default": false,
      "description": "True jika kegiatan ini menugaskan pegawai tertentu (mengaktifkan isian Tugas Untuk)"
    },
    "pegawai_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID Guru/Pegawai yang ditugaskan pada kegiatan (bisa lebih dari 1)"
    },
    "pegawai_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nama pegawai yang ditugaskan (auto dari data pegawai)"
    },
    "tugas_h1_notif_at": {
      "type": "string",
      "description": "Timestamp (ISO) saat pengingat WA H-1 terkirim ke pegawai yang ditugaskan (dedup)"
    }
  },
  "required": [
    "judul",
    "tanggal_mulai",
    "kategori",
    "tahun_ajaran"
  ]
}