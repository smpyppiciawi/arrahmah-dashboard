{
  "name": "Notifikasi Absen 3 Hari Siswa",
  "description": "Setiap jam sekolah (Senin-Jumat, 07:00-15:00 WIB) evaluasi Peringatan Absen 3 Hari secara PER STATUS (Sakit/Izin/Alfa dihitung masing-masing): Beruntun 3 Hari, Akumulasi 3 Hari/Minggu, dan Sama Hari 3 Minggu (hari yang sama di 3 minggu berbeda). Notifikasi WA + Email otomatis ke Wali Kelas, Waka Kesiswaan & Waka Kurikulum dari data Guru terkini (dedup per siswa/status/kriteria/minggu; gagal kirim diulang run berikutnya; menghormati sakelar gateway WA & Email jenis Siswa). Panel Absen 3 Hari di Dashboard Kepsek menampilkan hasilnya real-time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7-15 * * 1-5",
      "one_time_date": null,
      "timezone": "Asia/Jakarta",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notif_absen_3hari",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "evaluasi_absen_3hari": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifAbsen3Hari"
          },
          "then": "end",
          "x-base44": {
            "title": "Evaluasi & Kirim Notifikasi Absen 3 Hari",
            "description": "Deteksi per status (Beruntun \u00b7 Akumulasi \u00b7 Hari Sama) lalu kirim WA & Email ke Wali Kelas dan Waka"
          }
        }
      }
    ]
  }
}