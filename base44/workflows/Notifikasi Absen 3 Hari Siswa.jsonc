{
  "name": "Notifikasi Absen 3 Hari Siswa",
  "description": "Pemantauan harian Peringatan Absen Siswa: setiap hari belajar (Senin-Jumat, 15:00 WIB) mengevaluasi absensi periode 1 November 2026 sampai hari itu secara PER STATUS (Sakit/Izin/Alfa dihitung masing-masing) dengan tiga ketentuan: Beruntun 3 Hari, Akumulasi 3 Hari/Minggu, dan Sama Hari 3 Minggu. Pemicu selalu disimpan ke laporan Dashboard Kepsek walau pengiriman gagal, lalu WA dikirim via Fonnte ke Wali Kelas, Waka Kesiswaan, dan Waka Kurikulum dengan status terpisah per penerima (penerima yang sudah berhasil tidak dikirimi ulang; hari libur dilewati otomatis oleh fungsi).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 15 * * 1-5",
      "one_time_date": null,
      "timezone": "Asia/Jakarta",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notif_absen_3hari",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "evaluasi_absen_3hari": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifAbsen3Hari"
          },
          "then": "end",
          "x-base44": {
            "title": "Evaluasi & Kirim Notifikasi Absen Siswa",
            "description": "Periode 1 Nov s/d hari ini \u00b7 simpan pemicu \u00b7 WA per penerima (Wali Kelas & Waka)"
          }
        }
      }
    ]
  }
}