  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "h1_tugas_pegawai",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "kirim_wa_h1_tugas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifTugasPegawai"
          },
          "then": "end",
          "x-base44": {
            "title": "Kirim WA H-1 Tugas Pegawai",
            "description": "Cek kegiatan besok & kirim WA ke pegawai"
          }
        }
      }
    ]
  },
  "name": "Notifikasi H-1 Tugas Pegawai",
  "description": "Setiap hari pukul 06:30 WIB, cek kegiatan Kalender Akademik besok yang menugaskan pegawai tertentu dan kirim pengingat WA H-1 melalui WA Gateway ke tiap pegawai terpilih (dedup per kegiatan)"
