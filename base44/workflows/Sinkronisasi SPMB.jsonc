{
  "description": "Menarik data pendaftar, wawancara, dan pembayaran dari SPMB setiap 15 menit; pembayaran baru otomatis tercatat di buku kas (idempoten)",
  "name": "Sinkronisasi SPMB",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sinkronisasi_spmb",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "tarik_data_spmb": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSpmb",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Tarik Data SPMB",
            "description": "Sinkron pendaftar, wawancara & pembayaran"
          }
        }
      }
    ]
  }
}